# secrets and credentials
.env
.env.*
*.pem
*.key
**/credentials*

# raw private transcripts and worker files never enter this repo
transcripts/
*.transcript.jsonl
subagents/

# caches, temp, worker scratch
__pycache__/
*.pyc
.pytest_cache/
.symforge/
.citadel/
.codex/
.planning/
tmp/
temp/
*.tmp

# build and environments
.venv/
venv/
target/
node_modules/
dist/

# T3 fixture: large debug logs and scratch outputs stay local; event captures are committed
fixtures/**/*.debug.txt
fixtures/**/out.txt

# T4 fixture: gate state is per run; the contract is committed, the journals are not
fixtures/**/.supervisor/*
!fixtures/**/.supervisor/contract.json
